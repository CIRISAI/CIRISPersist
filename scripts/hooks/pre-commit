#!/usr/bin/env bash
# pre-commit hook for CIRISPersist.
#
# Runs the FAST CI checks (fmt + clippy) so we never push code that
# clippy or rustfmt rejects. Tests are gated on pre-push (slower).
#
# Installed by `./scripts/install-hooks.sh`. To run manually:
#   ./scripts/hooks/pre-commit
#
# To bypass in an emergency (NOT for routine work):
#   git commit --no-verify
# Don't make a habit of it — bypassing means CI catches it instead,
# which loses you 5+ minutes per round trip vs. the 10s this hook costs.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Tracked-but-staged-only check: if there's nothing in the index
# (`git diff --cached --quiet` exits 0), don't run anything.
if git diff --cached --quiet; then
    exit 0
fi

STAGED="$(git diff --cached --name-only)"

# ── A GATE WHOSE SCRIPT PREDATES THE BRANCH SKIPS; IT DOES NOT ABORT ──
#
# `.git/hooks` is COMMON to every worktree, and `install-hooks.sh` installs
# these hooks as SYMLINKS into the shared checkout's working tree. So the
# hook BODY that runs is always the one on the shared checkout's current
# branch, while the TREE being committed is the worktree's branch. The two
# are routinely different commits.
#
# Consequence: a gate introduced in commit N fires on every branch that
# predates N — where its script does not exist — and `python3 scripts/x.py`
# dies with "can't open file", aborting a perfectly valid commit. That
# happened with #595's `scripts/pyi_surface.py` across every branch cut
# before it landed.
#
# An abort on a valid branch is worse than no gate at all: it teaches people
# to reach for `git commit --no-verify`, which skips every OTHER gate too.
# So a gate whose script is ABSENT from the checked-out tree is SKIPPED —
# loudly, naming itself and saying why. Never abort, and never silently
# pass: the notice is the difference between "not run" and "clean".
gate_script_present() {  # $1 = script path (repo-relative), $2 = gate name
    if [ -f "$1" ]; then
        return 0
    fi
    echo "─── pre-commit: SKIPPED — $2 ───" >&2
    echo "    reason: $1 does not exist in this tree." >&2
    echo "    The hook in .git/hooks is shared across all worktrees and is newer" >&2
    echo "    than this branch ($(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo DETACHED))." >&2
    echo "    This gate was NOT run and did NOT pass. CI still enforces it." >&2
    echo "    Do NOT reach for --no-verify: the remaining gates below still run." >&2
    return 1
}

# v25.x (CIRISPersist#585) — the coverage gate keys off the files that
# CAN break coverage, which are not Rust files: Cargo.toml's feature
# table, the workflow, and the derivation itself. Milliseconds, so it
# runs before the expensive Rust gates and before their file filter.
if echo "$STAGED" | grep -qE '^Cargo\.toml$|^\.github/workflows/ci\.yml$|^scripts/ci_feature_matrix\.py$|^pyproject\.toml$'; then
    if gate_script_present scripts/ci_feature_matrix.py "feature-matrix coverage gate"; then
        echo "─── pre-commit: feature-matrix coverage gate ───"
        # Same predicate, same implementation, as CI's `lint` job.
        if ! python3 scripts/ci_feature_matrix.py check; then
            echo
            echo "✗ feature coverage gate failed — see above." >&2
            exit 1
        fi
    fi
fi

# CIRISPersist#595 — the FFI-surface + taxonomy gate, keyed off the files that
# CAN break it: the PyO3 sources, the stub, the pinned classification, and the
# derivation itself. Sub-second, no compilation, so it runs before the Rust
# gates. Catching it here matters more than usual: the failure mode is invisible
# locally (Rust tests stay green) and only shows up in a DOWNSTREAM repo's type
# checker, as "that method does not exist".
if echo "$STAGED" | grep -qE '^src/ffi/|^python/ciris_persist/ciris_persist\.pyi$|^scripts/pyi_surface\.py$|^scripts/ffi_taxonomy\.tsv$'; then
    if gate_script_present scripts/pyi_surface.py "FFI surface + taxonomy gate"; then
        echo "─── pre-commit: FFI surface + taxonomy gate ───"
        # Same predicate, same implementation, as CI's `lint` job.
        if ! python3 scripts/pyi_surface.py check; then
            echo
            echo "✗ FFI surface gate failed — see above." >&2
            echo '  `scripts/pyi_surface.py emit` adds the derived entries;' >&2
            echo '  `propose` lists what still needs a classification CHOSEN.' >&2
            exit 1
        fi
    fi
fi

# v28.3.0 (CIRISPersist#599) — a doc comment naming a version that never shipped.
# `v25.2.0` was cited 30 times: written during the cut that shipped as 26.0.0.
# The failure is silent and self-propagating — the next agent greps the
# convention and copies the phantom string, which is how one wrong number became
# 93 for `v12.7.0`. Cheap and compile-free, so it runs with the other fast gates.
if echo "$STAGED" | grep -qE '\.rs$|^CHANGELOG\.md$|^Cargo\.toml$|^evidence/doc_version_baseline\.tsv$|^scripts/doc_version_refs\.py$'; then
    if gate_script_present scripts/doc_version_refs.py "doc version reference gate"; then
        echo "─── pre-commit: doc version references ───"
        # Same predicate, same implementation, as CI's `lint` job.
        if ! python3 scripts/doc_version_refs.py; then
            echo
            echo "✗ doc version gate failed — see above." >&2
            echo '  Do NOT add the version to evidence/doc_version_baseline.tsv;' >&2
            echo '  that ratchet is being burned down (CIRISPersist#599).' >&2
            exit 1
        fi
    fi
fi

# Only run the Rust gates if Rust files changed. Bench-only /
# changelog-only / migration-only / docs-only commits skip them.
if ! echo "$STAGED" | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
    exit 0
fi

echo "─── pre-commit: cargo fmt --check ───"
if ! cargo fmt --all --check; then
    echo
    echo "✗ rustfmt found unformatted files. Run \`cargo fmt --all\` and re-stage." >&2
    exit 1
fi

# v25.x (CIRISPersist#585) — the feature list is DERIVED from
# Cargo.toml via the same script CI's `lint` job asks. It used to be
# spelled out here as `postgres,pyo3,server,sqlite,tls` under a comment
# claiming it matched "the CI matrix's strictest job" — it did not, and
# had not for a long time (it carried `tls`, which no CI job compiled,
# and omitted all five substrate axes that every CI leg carries). A
# third hand-written copy of the feature list, disagreeing with the
# other two: exactly the #585 defect, one layer out.
#
# CI additionally runs `cargo clippy --all-features --all-targets --
# -D warnings`, which is what makes coverage total. It is not run here
# because it pulls the ~500MB Candle/ORT graph; run it by hand before
# pushing anything that touches feature-gated code.
#
# Computed on its own line, NOT inline in the `if` — `set -e` is
# suppressed inside an `if` condition, so a failing substitution there
# would silently degrade to `--features ""` and lint almost nothing.
#
# On a branch that predates #585 the derivation script does not exist, and
# `set -e` would kill the hook here with a bare python traceback. There is no
# honest fallback: hand-writing a feature list is the exact defect #585
# deleted, and `--features ""` lints almost nothing while printing a
# clippy-passed line. So the gate SKIPS and says so.
if gate_script_present scripts/ci_feature_matrix.py "cargo clippy (shipped shape)"; then
    LINT_FEATURES="$(python3 scripts/ci_feature_matrix.py set lint)"
    if [ -z "$LINT_FEATURES" ]; then
        # Script exists but produced nothing — a real defect in the
        # derivation, not a stale branch. Refuse rather than lint `--features ""`.
        echo
        echo "✗ scripts/ci_feature_matrix.py set lint produced an EMPTY feature set." >&2
        echo "  Refusing to run clippy with no features — that would pass vacuously." >&2
        exit 1
    fi
    echo "─── pre-commit: cargo clippy (shipped shape, all targets) ───"
    if ! cargo clippy \
            --features "$LINT_FEATURES" \
            --all-targets \
            -- -D warnings; then
        echo
        echo "✗ clippy found warnings. Fix them; re-stage; re-commit." >&2
        exit 1
    fi
fi

# v0.5.4 (CIRISPersist#28) — bare `row.get(...)` on a `tokio_postgres::Row`
# panics on NULL when the type isn't `Option<_>`. CIRISPersist#24 was
# exactly this class. Every postgres-side read must go through
# `safe_get` / `safe_get_with` (PgRowExt). The grep below catches new
# bare reads in src/store/postgres.rs; the helper itself + its tests
# are the only legitimate `.get(` sites and live in the trait impl.
#
# Allowlist intentionally narrow: only postgres.rs is gated.
# - sqlite (`rusqlite::Row::get`) already returns `Result` and is
#   safe by default.
# - The PgRowExt trait impl's own `try_get` call is the single
#   approved low-level read site.
echo "─── pre-commit: ban bare Row::get in postgres backend ───"
if git diff --cached --name-only | grep -q '^src/store/postgres\.rs$'; then
    # Strip the PgRowExt trait impl (the only legit `try_get` site) from
    # the search by skipping anything inside `impl PgRowExt for `.
    BAD=$(grep -nE '\brow\.get\(|\b\.get::<' src/store/postgres.rs \
        | grep -vE '//|^\s*\*' \
        || true)
    if [ -n "$BAD" ]; then
        echo
        echo "✗ Bare row.get / .get::<> found in src/store/postgres.rs:" >&2
        echo "$BAD" >&2
        echo >&2
        echo "Use row.safe_get(col) or row.safe_get_with(col, Err::Variant) instead." >&2
        echo "(PgRowExt's try_get is the only approved low-level site.)" >&2
        exit 1
    fi
fi

echo "✓ pre-commit checks passed"
