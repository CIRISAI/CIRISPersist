#!/usr/bin/env bash
# pre-push hook for CIRISPersist.
#
# Runs the SLOWER test gate before push. Pre-commit handles fmt +
# clippy; pre-push runs the lib tests so we don't push code that's
# broken at the unit level.
#
# v53.2.0 (CIRISPersist#1010) — ONE FINGERPRINT. This hook used to run
# `cargo test --features postgres,pyo3,server --lib` with no RUSTFLAGS: a
# feature set matching no certify leg, under flags weaker than CI's, so
# nothing it compiled was ever reused. It now builds certify's `core` leg
# exactly — RUSTFLAGS derived from ci.yml, the feature set derived by
# `ci_feature_matrix.py set core`, the default profile, nextest — via
# `scripts/ci_env.sh`, the file certify.sh sources. The dependency graph and
# the lib-test unit compiled here are the ones certify's first leg finds
# warm. `scripts/fingerprint_check.sh` runs this hook with
# CIRIS_HOOK_FINGERPRINT_ONLY=1 and fails if its triple differs from
# certify's.
#
# Postgres + maturin integration tests still run only in CI (they
# need TimescaleDB containers + cross-platform builds).
#
# Installed by `./scripts/install-hooks.sh`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ── the build fingerprint, shared with certify.sh (#1010) ──────────────
# `.git/hooks` is common to every worktree and links into the shared
# checkout, so this BODY can be newer than the branch being pushed. Prefer
# the pushed tree's own ci_env.sh (it reads that tree's ci.yml); fall back to
# the one beside this hook. A branch too old to derive a feature set at all
# SKIPS the test gate loudly rather than aborting a valid push (the
# pre-commit hook's rule: an abort teaches `--no-verify`) — and never
# hand-spells a feature list, which is the #585 defect.
CI_ENV="$REPO_ROOT/scripts/ci_env.sh"
[ -f "$CI_ENV" ] || CI_ENV="$(dirname "$(readlink -f "$0")")/../ci_env.sh"
HOOK_CMD=()
if [ -f "$CI_ENV" ] && [ -f scripts/ci_feature_matrix.py ]; then
    # shellcheck source=scripts/ci_env.sh
    . "$CI_ENV"
    # Computed on their own lines, NOT inline — `set -e` is suppressed inside
    # an `if`, and an empty value would test with weaker flags than certify.
    HOOK_RUSTFLAGS="$(ci_rustflags)"
    HOOK_FEATURES="$(ci_feature_csv core)"
    export RUSTFLAGS="$HOOK_RUSTFLAGS"
    HOOK_CMD=(cargo nextest run --features "$HOOK_FEATURES" --lib)
fi

if [ "${CIRIS_HOOK_FINGERPRINT_ONLY:-0}" = "1" ]; then
    [ ${#HOOK_CMD[@]} -gt 0 ] || { echo "pre-push: no derivable fingerprint in this tree" >&2; exit 2; }
    printf 'RUSTFLAGS=%s\n' "$RUSTFLAGS"
    printf 'CMD='; printf '%q ' "${HOOK_CMD[@]}"; echo
    exit 0
fi

# Skip if we're pushing to a branch that hasn't changed any Rust
# files since main — pre-push gets called even for tag pushes that
# don't touch code on top of an already-tested commit.
#
# Heuristic: read the refs being pushed from stdin (git pre-push
# protocol — `<local_ref> <local_sha> <remote_ref> <remote_sha>` per
# line). If every local_sha is already an ancestor of an existing
# remote ref or a tag pointing at code already on main, skip.
RANGES=()
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Deletion; nothing to test.
        continue
    fi
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New ref. NOT "$local_sha" alone: `git diff --name-only <commit>`
        # diffs the WORKING TREE against it, which on a clean tree is empty,
        # so every first push of a branch read "no Rust files in pushed
        # range" and skipped the tests (v44.2.0's #580 red reached CI this
        # way). Test what the branch adds over main; fall back to the tip's
        # own parent when main is unknown.
        base="$(git merge-base origin/main "$local_sha" 2>/dev/null || git rev-parse "$local_sha^" 2>/dev/null || true)"
        if [ -n "$base" ]; then
            RANGES+=("$base..$local_sha")
        else
            RANGES+=("$local_sha^!")
        fi
    else
        # Update; test the new range.
        RANGES+=("$remote_sha..$local_sha")
    fi
done

if [ ${#RANGES[@]} -eq 0 ]; then
    exit 0
fi

# Did any *.rs / Cargo.* files change in the pushed range(s)?
RUST_TOUCHED=0
for r in "${RANGES[@]}"; do
    if git diff --name-only "$r" 2>/dev/null | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
        RUST_TOUCHED=1
        break
    fi
done

if [ $RUST_TOUCHED -eq 0 ]; then
    echo "─── pre-push: no Rust files in pushed range; skipping tests ───"
    exit 0
fi

if [ ${#HOOK_CMD[@]} -eq 0 ]; then
    echo "─── pre-push: SKIPPED — lib tests ───" >&2
    echo "    reason: scripts/ci_env.sh or scripts/ci_feature_matrix.py is absent from this tree," >&2
    echo "    so the core leg's fingerprint cannot be derived. NOT run, NOT passed; CI enforces it." >&2
    exit 0
fi

echo "─── pre-push: nextest --lib (certify's core leg: RUSTFLAGS='$RUSTFLAGS', --features $HOOK_FEATURES) ───"
if ! NEXTEST_TEST_THREADS="$(ci_single_leg_threads)" "${HOOK_CMD[@]}" 2>&1 | tail -15; then
    echo
    echo "✗ tests failing. Fix them locally before pushing." >&2
    echo "  Bypass (NOT for routine use): git push --no-verify" >&2
    exit 1
fi

# v0.5.8 — PG-gated tests early-return when CIRIS_PERSIST_TEST_PG_URL
# is unset, so fixture bugs in §A/B/C/D/E/F/G/H/I tests slip through
# local cargo test and only surface in CI. Try to discover a local
# Postgres (the ciris-qa-postgres docker container is the common dev
# setup) and re-run the read-engine tests against it.
#
# Bypass: if docker / live PG isn't reachable, we warn but don't
# fail — historical contract is "unit tests must pass, integration
# tests run in CI." Don't break the historical contract; just nag.
echo "─── pre-push: PG integration sweep (if available) ───"
if [ -z "${CIRIS_PERSIST_TEST_PG_URL:-}" ]; then
    # Heuristic: look for the ciris-qa-postgres container.
    if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null \
        | grep -q '^ciris-qa-postgres$'; then
        PG_USER=$(docker inspect ciris-qa-postgres --format '{{range .Config.Env}}{{println .}}{{end}}' \
            | grep '^POSTGRES_USER=' | cut -d= -f2)
        PG_PASS=$(docker inspect ciris-qa-postgres --format '{{range .Config.Env}}{{println .}}{{end}}' \
            | grep '^POSTGRES_PASSWORD=' | cut -d= -f2)
        PG_DB=$(docker inspect ciris-qa-postgres --format '{{range .Config.Env}}{{println .}}{{end}}' \
            | grep '^POSTGRES_DB=' | cut -d= -f2)
        if [ -n "${PG_USER}" ] && [ -n "${PG_PASS}" ] && [ -n "${PG_DB}" ]; then
            export CIRIS_PERSIST_TEST_PG_URL="postgres://${PG_USER}:${PG_PASS}@localhost:5432/${PG_DB}"
            echo "  using ciris-qa-postgres container → ${PG_USER}@localhost:5432/${PG_DB}"
        fi
    fi
fi

# v0.6.0-α2 — cargo-deny advisories gate. v0.6.0-α1 burned a CI run
# on a transitive `number_prefix` / `paste` unmaintained advisory
# pulled in by heavy ML deps; pre-push catches that class now if
# cargo-deny is installed (it's a separate binary, not a cargo
# subcommand). Skip silently when not installed.
if command -v cargo-deny >/dev/null 2>&1; then
    echo "─── pre-push: cargo-deny check advisories ───"
    if ! cargo deny check advisories --hide-inclusion-graph 2>&1 | tail -20; then
        echo
        echo "✗ cargo-deny found advisories." >&2
        echo "  Add an ignore block to deny.toml or remove the offending dep." >&2
        echo "  Bypass (NOT for routine use): git push --no-verify" >&2
        exit 1
    fi
    echo "✓ cargo-deny advisories clean"
else
    echo "  ⚠ cargo-deny not installed locally (\`cargo install cargo-deny\`)"
    echo "    skipping advisory gate — CI will catch it."
fi

if [ -n "${CIRIS_PERSIST_TEST_PG_URL:-}" ]; then
    if ! NEXTEST_TEST_THREADS="$(ci_single_leg_threads)" "${HOOK_CMD[@]}" -E 'test(/read_section/)' 2>&1 | tail -10; then
        echo
        echo "✗ PG integration tests failing against live Postgres." >&2
        echo "  These would have failed CI; fix before pushing." >&2
        echo "  Bypass (NOT for routine use): git push --no-verify" >&2
        exit 1
    fi
    echo "✓ PG integration tests passed"
else
    echo "  ⚠ no live Postgres available (CIRIS_PERSIST_TEST_PG_URL unset"
    echo "    and ciris-qa-postgres container not running) — §A/B/C/D/E/F/G/H/I"
    echo "    tests will run only in CI. Two release versions burned to fixture"
    echo "    bugs in v0.5.5/.6/.7; consider \`docker start ciris-qa-postgres\`."
fi

echo "✓ pre-push tests passed"
