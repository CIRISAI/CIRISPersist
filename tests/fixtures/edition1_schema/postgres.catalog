con	cirislens_secrets.master_key_meta	master_key_meta_pkey	p	PRIMARY KEY (key_ref)	true	false	false
con	cirislens_secrets.master_key_meta	master_key_meta_rotated_to_fkey	f	FOREIGN KEY (rotated_to) REFERENCES cirislens_secrets.master_key_meta(key_ref)	true	false	false
con	cirislens_secrets.secrets	secrets_content_hmac_key	u	UNIQUE (content_hmac)	true	false	false
con	cirislens_secrets.secrets	secrets_pkey	p	PRIMARY KEY (secret_uuid)	true	false	false
con	cirislens_secrets.secrets	secrets_sensitivity_level_check	c	CHECK ((sensitivity_level = ANY (ARRAY['low'::text, 'medium'::text, 'high'::text, 'critical'::text])))	true	false	false
con	cirisnode.credits_ledger	credits_ledger_attestation_id_fkey	f	FOREIGN KEY (attestation_id) REFERENCES cirislens.federation_attestations(attestation_id) ON DELETE CASCADE	true	false	false
con	cirisnode.credits_ledger	credits_ledger_pkey	p	PRIMARY KEY (contributor_id, domain, language, subject)	true	false	false
con	cirisnode.expertise_ledger	expertise_ledger_attestation_id_fkey	f	FOREIGN KEY (attestation_id) REFERENCES cirislens.federation_attestations(attestation_id) ON DELETE CASCADE	true	false	false
con	cirisnode.expertise_ledger	expertise_ledger_expertise_check	c	CHECK (((expertise >= (0)::double precision) AND (expertise <= (1)::double precision)))	true	false	false
con	cirisnode.expertise_ledger	expertise_ledger_pkey	p	PRIMARY KEY (contributor_id, domain, language)	true	false	false
con	cirisnode.federation_delivery_attestations	federation_delivery_attestati_announcement_canonical_hash_check	c	CHECK ((octet_length(announcement_canonical_hash) = 32))	true	false	false
con	cirisnode.federation_delivery_attestations	federation_delivery_attestations_pkey	p	PRIMARY KEY (announcement_id, peer_key_id)	true	false	false
con	cirisnode.federation_delivery_attestations	federation_delivery_attestations_signature_classical_check	c	CHECK ((octet_length(signature_classical) = 64))	true	false	false
con	cirisnode.federation_delivery_attestations	federation_delivery_attestations_signature_pqc_check	c	CHECK (((signature_pqc IS NULL) OR (octet_length(signature_pqc) = 3309)))	true	false	false
con	cirisnode.federation_delivery_attestations	federation_delivery_attestations_transport_id_check	c	CHECK ((transport_id = ANY (ARRAY['reticulum'::text, 'tcp_tls'::text, 'http_over_tls'::text, 'other'::text])))	true	false	false
con	cirisnode.promotion_attestations	promotion_attestations_pkey	p	PRIMARY KEY (attestation_id)	true	false	false
con	cirisnode.promotion_attestations	promotion_attestations_target_kind_check	c	CHECK ((target_kind = ANY (ARRAY['contribution'::text, 'vote'::text, 'moderation_event'::text, 'slashing_attestation'::text, 'reconsideration_attestation'::text])))	true	false	false
con	cirisnode.scheduled_takedown_actions	scheduled_takedown_actions_pkey	p	PRIMARY KEY (notice_contribution_id)	true	false	false
con	cirisnode.scheduled_takedown_actions	scheduled_takedown_actions_status_check	c	CHECK ((status = ANY (ARRAY['pending'::text, 'evicted'::text, 'counter_noticed'::text, 'expired'::text])))	true	false	false
