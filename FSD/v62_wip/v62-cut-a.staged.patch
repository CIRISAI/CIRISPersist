diff --git a/src/federation/edition2/door.rs b/src/federation/edition2/door.rs
index 47a51814..e6b036cd 100644
--- a/src/federation/edition2/door.rs
+++ b/src/federation/edition2/door.rs
@@ -347,3 +347,79 @@ pub fn raw_payload(bytes: &[u8]) -> Option<Vec<u8>> {
     };
     inner.as_array()?.get(2)?.as_bytes().map(<[u8]>::to_vec)
 }
+
+/// v62.0.0 (JSON-cut slice A; CC 2.6.1.12, rc20 "nothing carries, clean
+/// mesh") — **THE switch that shuts the earlier-form doors.** While it is
+/// `false` every JSON door admits as before; slice F flips it to `true`, in
+/// this one place, and every door wired to [`refuse_earlier_form`] refuses
+/// an earlier-form object by name ([`token::EARLIER_FORM_OBJECT`]).
+pub const EARLIER_FORM_DOORS_SHUT: bool = false;
+
+#[cfg(test)]
+tokio::task_local! {
+    /// A test forces the switch on for the future it scopes
+    /// ([`with_earlier_form_doors_shut`]), so a witness can assert each
+    /// door's refusal before F flips [`EARLIER_FORM_DOORS_SHUT`].
+    static FORCE_SHUT: bool;
+}
+
+/// Is the earlier form shut at this node's doors?
+#[must_use]
+pub fn earlier_form_doors_shut() -> bool {
+    #[cfg(test)]
+    if FORCE_SHUT.try_with(|f| *f).unwrap_or(false) {
+        return true;
+    }
+    EARLIER_FORM_DOORS_SHUT
+}
+
+/// Test only: run `fut` with the switch forced on.
+#[cfg(test)]
+pub(crate) async fn with_earlier_form_doors_shut<T>(
+    fut: impl std::future::Future<Output = T>,
+) -> T {
+    FORCE_SHUT.scope(true, fut).await
+}
+
+/// **The one shared refusal every earlier-form door calls** (v62.0.0,
+/// JSON-cut slice A). `plane` names the door. It is inert until
+/// [`EARLIER_FORM_DOORS_SHUT`] is `true`; then it refuses
+/// [`token::EARLIER_FORM_OBJECT`] (`federation_malformed_row`, Python
+/// `ValueError`), before any parse or verify of the object.
+///
+/// # Errors
+/// [`token::EARLIER_FORM_OBJECT`] once the doors are shut.
+pub fn refuse_earlier_form(plane: &'static str) -> Result<(), Error> {
+    if earlier_form_doors_shut() {
+        return Err(Error::malformed_row(
+            plane,
+            token::EARLIER_FORM_OBJECT,
+            format!(
+                "an object of the earlier form (a JSON object signed over its JCS image, CC 8.11) \
+                 at the `{plane}` door: a node of this form reads this form only; offer the \
+                 edition-2 statement (CC 2.6.1.12)"
+            ),
+        ));
+    }
+    Ok(())
+}
+
+/// [`refuse_earlier_form`] for a row at the attestation plane: a row that
+/// carries its edition-2 statement (`ceg_statement`) is the edition-2 door's
+/// mapping, never an earlier-form object, and passes.
+///
+/// # Errors
+/// As [`refuse_earlier_form`].
+pub fn refuse_earlier_form_row(
+    plane: &'static str,
+    row: &crate::federation::types::Attestation,
+) -> Result<(), Error> {
+    if row
+        .attestation_envelope
+        .get(super::ingest::STATEMENT_MEMBER)
+        .is_some()
+    {
+        return Ok(());
+    }
+    refuse_earlier_form(plane)
+}
diff --git a/src/federation/edition2/ingest.rs b/src/federation/edition2/ingest.rs
index 71b20739..50d280f6 100644
--- a/src/federation/edition2/ingest.rs
+++ b/src/federation/edition2/ingest.rs
@@ -526,3 +526,80 @@ where
 
 /// The tier replication and tier ingest deliver at.
 pub const INGEST_TIER: &str = attestation_tier::FEDERATION;
+
+/// v62.0.0 (JSON-cut slice A) — what [`apply_replicated_statement`] did with
+/// one statement a peer offered. A `Refused` is a policy outcome that
+/// ADVANCES the replication cursor (the lost-race `StoreConflict`, fail
+/// closed, safe to re-offer); a waiting statement is never an outcome: it is
+/// the retryable `federation_attester_key_unknown` error, and the cursor
+/// stays where it is.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ReplicatedStatementOutcome {
+    /// The statement was new here and is kept ([`StatementOutcome`] says
+    /// where).
+    Admitted(StatementOutcome),
+    /// This node already held the statement byte for byte: nothing changed.
+    Unchanged(StatementOutcome),
+    /// The statement was not kept and the store is untouched.
+    Refused {
+        /// Which branch refused.
+        reason: crate::federation::attestation_apply::AttestationRefusalReason,
+    },
+}
+
+impl ReplicatedStatementOutcome {
+    /// Does this outcome advance the sender's cursor? Every outcome does;
+    /// only an `Err` (a statement waiting on a key, a backend failure) holds
+    /// it. Spelled out for the replication loop.
+    #[must_use]
+    pub const fn advances_cursor(&self) -> bool {
+        true
+    }
+}
+
+/// v62.0.0 (JSON-cut slice A) — **the replicated statement door**: one
+/// edition-2 statement as a peer delivered it, under the id the peer offered
+/// it as (`offered_id`), at tier `federation` ([`INGEST_TIER`]), through
+/// [`put_statement`] and so through every gate the local door runs.
+///
+/// - an id the bytes do not name is `row_id_mismatch` (terminal);
+/// - a statement whose signer's key record is not held waits:
+///   `federation_attester_key_unknown`, retryable, and the cursor must NOT
+///   advance past it;
+/// - a key conflict the plan did not see (a duplicate key in the store, a
+///   key-record conflict) is `Refused { StoreConflict }`: fail closed, the
+///   held rows untouched, safe to re-offer;
+/// - every other gate refusal keeps its typed [`Error`].
+///
+/// # Errors
+/// As above.
+pub async fn apply_replicated_statement<F>(
+    dir: &F,
+    bytes: &[u8],
+    offered_id: &Digest32,
+) -> Result<ReplicatedStatementOutcome, Error>
+where
+    F: FederationDirectory + ?Sized,
+{
+    use crate::federation::attestation_apply::AttestationRefusalReason;
+    match put_statement(dir, bytes, Some(offered_id), INGEST_TIER).await {
+        Ok(out) => {
+            let new = match &out {
+                StatementOutcome::KeyPlane { new, .. }
+                | StatementOutcome::Voice { new, .. }
+                | StatementOutcome::Row { new, .. } => *new,
+            };
+            Ok(if new {
+                ReplicatedStatementOutcome::Admitted(out)
+            } else {
+                ReplicatedStatementOutcome::Unchanged(out)
+            })
+        }
+        Err(Error::Conflict(_) | Error::KeyRecordConflict { .. }) => {
+            Ok(ReplicatedStatementOutcome::Refused {
+                reason: AttestationRefusalReason::StoreConflict,
+            })
+        }
+        Err(e) => Err(e),
+    }
+}
