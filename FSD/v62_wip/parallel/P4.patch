+/// I3085: nothing held seats nobody.
+#[test]
+fn i3085_no_bundle_in_force_seats_no_accord_holder() {
+    let none = super::genesis::GenesisInForce::default();
+    assert!(
+        !super::standing::accord_standing_in(&none, &iref(&key(85)), ACCORD),
+        "I3085"
+    );
+}
