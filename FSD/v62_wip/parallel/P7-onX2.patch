+/// v62.0.0 (CC 2.6.1.7, RULINGS "composite signatures only") — **the domain
+/// tag that opens the bytes a trace's composite signature covers**
+/// ([`trace_signature_message`]).
+///
+/// It keeps a trace signature from ever reading as any other object signed by
+/// the same composite key: a COSE `Sig_structure` opens with a CBOR array
+/// head, a secrets request with `ciris-persist:secrets-request:v1`, and a
+/// trace with this text. The name is the CC family of the object
+/// (`trace:complete:v1`, RULINGS "Planes": SPLIT).
+pub const TRACE_SIGNATURE_CONTEXT: &[u8] = b"ciris-persist:trace:complete:v1";
+
+/// v62.0.0 — **the exact bytes an Agent signs, with ONE composite
+/// ML-DSA-65-Ed25519 signature, for a trace:**
+///
+/// ```text
+/// TRACE_SIGNATURE_CONTEXT || canonical_bytes_for_trace(trace, canonicalizer)
+/// ```
+///
+/// `canonical_bytes_for_trace` is unchanged (the shape is dispatched by the
+/// signed `trace_schema_version`, with the signed `run_kind` joined; the
+/// canonicalizer is the one [`canon_version_for_trace_schema`] names: RFC
+/// 8785 JCS for major ≥ 3, Python-compat below). The tag is fixed-length
+/// and the canonical bytes follow it directly, so the message is
+/// unambiguous. The composite primitive then applies its own LAMPS -19
+/// representative (`ciris_crypto::composite::message_representative`): the
+/// Agent hands THESE bytes to its composite signer as the message, never a
+/// hash of them.
+///
+/// # Errors
+/// As [`canonical_bytes_for_trace`].
+pub fn trace_signature_message<C>(
+    trace: &CompleteTrace,
+    canonicalizer: &C,
+) -> Result<Vec<u8>, Error>
+where
+    C: Canonicalizer + ?Sized,
+{
+    let canonical = canonical_bytes_for_trace(trace, canonicalizer)?;
+    let mut out = Vec::with_capacity(TRACE_SIGNATURE_CONTEXT.len() + canonical.len());
+    out.extend_from_slice(TRACE_SIGNATURE_CONTEXT);
+    out.extend_from_slice(&canonical);
+    Ok(out)
+}
+
+/// v62.0.0 — the two signature forms a trace can arrive in.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TraceSignatureForm {
+    /// The v62 form: `signature_key_id` is an edition-2 identity-ref (the
+    /// kid, carried as its thumbprint here) and `signature` is ONE composite
+    /// signature over [`trace_signature_message`]. None of the three
+    /// earlier-form PQC members (`signature_ml_dsa_65`, `pubkey_ml_dsa_65`,
+    /// `pqc_key_id`) is present.
+    Composite([u8; 32]),
+    /// The earlier form (v7.2.0, #225): an Ed25519 `signature` plus a bound
+    /// ML-DSA-65 `signature_ml_dsa_65` over `canonical || ed25519_sig`, the
+    /// components looked up separately by `signature_key_id` / `pqc_key_id`.
+    /// Any trace that is not [`TraceSignatureForm::Composite`] is this form,
+    /// including a classical-only one and a trace that mixes an identity-ref
+    /// kid with a PQC member.
+    BoundHybrid,
+}
+
+/// v62.0.0 — **which form is this trace signed in?** Read from the envelope
+/// members only (no key read, no verify). See [`TraceSignatureForm`].
+#[must_use]
+pub fn trace_signature_form(trace: &CompleteTrace) -> TraceSignatureForm {
+    if trace.signature_ml_dsa_65.is_some()
+        || trace.pubkey_ml_dsa_65.is_some()
+        || trace.pqc_key_id.is_some()
+    {
+        return TraceSignatureForm::BoundHybrid;
+    }
+    match crate::federation::edition2::ingest::kid_of_identity_ref(&trace.signature_key_id) {
+        Some(kid) => TraceSignatureForm::Composite(kid),
+        None => TraceSignatureForm::BoundHybrid,
+    }
+}
+
+/// v62.0.0 (CC 2.6.1.7) — **verify a trace's ONE composite signature** under
+/// `key`, over [`trace_signature_message`]. Pure: the key is the caller's,
+/// resolved by the trace's kid through the edition-2 key plane
+/// ([`crate::ingest::verify_trace_for_admission`]). Both halves must verify
+/// (the composite primitive does not say which failed).
+///
+/// # Errors
+/// [`Error::InvalidSignature`] when `signature` is not base64 or not a
+/// composite signature's length; [`Error::SignatureMismatch`] when it does
+/// not verify under `key`; the canonicalizer's errors.
+pub fn verify_trace_composite<C>(
+    trace: &CompleteTrace,
+    canonicalizer: &C,
+    key: &ciris_crypto::composite::CompositePublicKey,
+) -> Result<(), Error>
+where
+    C: Canonicalizer + ?Sized,
+{
+    let sig =
+        decode_signature(&trace.signature).map_err(|e| Error::InvalidSignature(e.to_string()))?;
+    if sig.len() != ciris_crypto::composite::SIGNATURE_LEN {
+        return Err(Error::InvalidSignature(format!(
+            "expected a {}-byte composite (ML-DSA-65-Ed25519) signature, got {} bytes",
+            ciris_crypto::composite::SIGNATURE_LEN,
+            sig.len()
+        )));
+    }
+    let message = trace_signature_message(trace, canonicalizer)?;
+    tracing::info!(
+        target: "federation_canonical_match",
+        wire = trace.trace_schema_version.as_str(),
+        trace_id = trace.trace_id.as_str(),
+        form = "composite",
+        "federation_canonical_match_total"
+    );
+    match key.verify(&message, &sig) {
+        Ok(()) => Ok(()),
+        Err(ciris_crypto::CryptoError::InvalidSignature { reason }) => {
+            Err(Error::InvalidSignature(reason))
+        }
+        Err(_) => Err(Error::SignatureMismatch),
+    }
+}
