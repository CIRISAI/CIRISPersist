+/// v62.0.0 — the plane name a trace refusal carries (the `plane` of the
+/// shared earlier-form refusals, [`crate::federation::edition2::door::refuse_earlier_form`]
+/// and [`crate::federation::edition2::projection::refuse_edition2_signer`]).
+pub const TRACE_PLANE: &str = "trace";
+
+/// A federation refusal at the trace door as the ingest error it surfaces
+/// as: a named refusal ([`crate::federation::Error::MalformedRow`]) keeps its
+/// token as [`IngestError::TraceRefused`]'s `kind` (Python `ValueError`,
+/// `(kind, detail)`; lens HTTP 422); a directory fault is a store error
+/// (`RuntimeError`, 5xx), never a refusal of the trace.
+fn trace_refusal(e: crate::federation::Error) -> IngestError {
+    match e {
+        crate::federation::Error::MalformedRow {
+            reason, message, ..
+        } => IngestError::TraceRefused {
+            kind: reason,
+            detail: message,
+        },
+        other => IngestError::Store(StoreError::Backend(format!(
+            "trace door directory read: {other}"
+        ))),
+    }
+}
+
+/// v62.0.0 (CC 2.6.1.12, RULINGS "composite signatures only") — **the
+/// earlier-form gate of the trace door.** A bound-hybrid trace
+/// ([`crate::verify::ed25519::TraceSignatureForm::BoundHybrid`]) is:
+///
+/// 1. refused `earlier_form_object` once the earlier-form doors are shut
+///    ([`crate::federation::edition2::door::refuse_earlier_form`], the one
+///    switch every door reads), before any key read or verify;
+/// 2. while they are open, refused `earlier_form_signer_is_edition2` when
+///    `signature_key_id` or `pqc_key_id` names an edition-2 key: a
+///    composite's components are never checked as standalone signers, and
+///    the projected `federation_keys` row is a read model, never a key an
+///    earlier-form signature verifies under.
+///
+/// # Errors
+/// [`IngestError::TraceRefused`] with the token; a directory fault as
+/// [`IngestError::Store`].
+async fn refuse_earlier_form_trace<B>(backend: &B, trace: &CompleteTrace) -> Result<(), IngestError>
+where
+    B: crate::federation::FederationDirectory + ?Sized,
+{
+    crate::federation::edition2::door::refuse_earlier_form(TRACE_PLANE).map_err(trace_refusal)?;
+    let mut signers: Vec<&str> = vec![trace.signature_key_id.as_str()];
+    if let Some(pqc) = trace.pqc_key_id.as_deref() {
+        signers.push(pqc);
+    }
+    crate::federation::edition2::projection::refuse_edition2_signer(backend, TRACE_PLANE, &signers)
+        .await
+        .map_err(trace_refusal)
+}
+
+/// v62.0.0 (CC 2.6.1.7) — **the composite trace door.** The trace's kid
+/// (`signature_key_id`, an edition-2 identity-ref) resolves through the
+/// edition-2 key plane
+/// ([`crate::federation::edition2::ingest::held_keys_for_kid`]); the key
+/// must be live ([`crate::federation::edition2::liveness::HeldKeys::liveness`],
+/// the half-open reading every edition-2 statement gets) at the trace's
+/// SIGNED `completed_at`, the instant the producer sealed it, as a statement
+/// is read at its own `asserted_at`; and the ONE composite signature must
+/// verify under that key over
+/// [`trace_signature_message`](crate::verify::ed25519::trace_signature_message)
+/// ([`crate::verify::ed25519::verify_trace_composite`]). No component key is
+/// looked up and no earlier-form directory (`accord_public_keys`,
+/// `federation_keys`) is read.
+///
+/// Refusals, all before anything is written:
+/// - no valid record of the kid held: `verify_unknown_key` (retryable: the
+///   key may not have arrived);
+/// - revoked, not covered at `completed_at`, or waiting on a deeper key:
+///   `verify_signer_not_live` (the detail names which);
+/// - not base64, or not a composite's length: `verify_invalid_signature`;
+/// - does not verify under the kid's key (a trace signed by any other key,
+///   or altered after signing): `verify_signature_mismatch`.
+///
+/// # Errors
+/// As listed; a key-plane read failure as [`IngestError::Store`].
+async fn verify_composite_trace_for_admission<B>(
+    backend: &B,
+    trace: &CompleteTrace,
+    kid: &crate::federation::edition2::Digest32,
+    body_sha256: &str,
+) -> Result<(), IngestError>
+where
+    B: crate::federation::FederationDirectory + ?Sized,
+{
+    use crate::federation::edition2::liveness::Liveness;
+    let key_id = &trace.signature_key_id;
+    let held = crate::federation::edition2::ingest::held_keys_for_kid(backend, kid)
+        .await
+        .map_err(|e| {
+            IngestError::Store(StoreError::Backend(format!(
+                "trace signer key plane read for {key_id}: {e}"
+            )))
+        })?;
+    // The SIGNED instant (part of every canonical shape), at ms. Before the
+    // epoch reads as 0, which no agent key's record covers.
+    let at = u64::try_from(trace.completed_at.parsed().timestamp_millis()).unwrap_or(0);
+    let not_live = |why: String| {
+        tracing::warn!(
+            envelope_signer_id = %key_id,
+            wire_body_sha256 = %body_sha256,
+            trace_id = %trace.trace_id,
+            reason = %why,
+            "ciris-persist: verify_signer_not_live — composite trace signer not live at completed_at"
+        );
+        IngestError::Verify(VerifyError::SignerNotLive(why))
+    };
+    let record = match held.liveness(kid, at) {
+        Liveness::Live(record) => record,
+        Liveness::NotHeld | Liveness::Invalid => {
+            tracing::warn!(
+                envelope_signer_id = %key_id,
+                wire_body_sha256 = %body_sha256,
+                trace_id = %trace.trace_id,
+                "ciris-persist: verify_unknown_key — no valid edition-2 key:record of the trace's kid is held"
+            );
+            return Err(IngestError::Verify(VerifyError::UnknownKey(key_id.clone())));
+        }
+        Liveness::Revoked => return Err(not_live(format!("revoked: {key_id}"))),
+        Liveness::NotCovered => {
+            return Err(not_live(format!(
+                "not_covered: no record of {key_id} covers completed_at {}",
+                trace.completed_at.wire()
+            )))
+        }
+        Liveness::Waiting(missing) => {
+            return Err(not_live(format!(
+                "waiting: a record of {key_id} waits on {} key(s) this node does not hold",
+                missing.len()
+            )))
+        }
+    };
+    let canon = trace_canonicalizer(trace.trace_schema_version.as_str());
+    crate::verify::ed25519::verify_trace_composite(trace, canon, &record.key).map_err(|e| {
+        let sig_b64_prefix: String = trace.signature.chars().take(16).collect();
+        tracing::warn!(
+            envelope_signer_id = %key_id,
+            wire_body_sha256 = %body_sha256,
+            trace_id = %trace.trace_id,
+            verify_error = %e.kind(),
+            signature_b64_prefix = %sig_b64_prefix,
+            "ciris-persist: composite trace signature rejected"
+        );
+        IngestError::Verify(e)
+    })
+}
+
