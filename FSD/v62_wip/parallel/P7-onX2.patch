@@ -0,0 +1,468 @@
+//! v62.0.0 (wave P7; CC 2.6.1.7, RULINGS "composite signatures only") — **the
+//! composite trace door, on every backend** (sqlite, and postgres when a test
+//! DSN is set).
+//!
+//! A trace (`trace:complete:v1`, the SPLIT plane) carries ONE composite
+//! ML-DSA-65-Ed25519 signature over
+//! [`trace_signature_message`](crate::verify::ed25519::trace_signature_message),
+//! verified under the live edition-2 key its kid (`signature_key_id`, an
+//! identity-ref) names. The bound-hybrid form is the earlier form.
+//!
+//! - **I3460** a composite-signed trace is admitted at ingest's verify step
+//!   ([`verify_trace_for_admission`], also `Engine.verify_trace`), with the
+//!   earlier-form doors open AND shut.
+//! - **I3461** the same trace through the whole pipeline
+//!   ([`IngestPipeline::receive_and_persist`], `VerifyMode::Full`): one
+//!   signature verified, its rows land.
+//! - **I3462** a bound-hybrid trace is refused `earlier_form_object` once the
+//!   doors are shut, before any key read; with the doors open it is NOT
+//!   refused by that name (the switch, not the form check, gates it).
+//! - **I3463** a classical-only trace (no PQC member, an earlier-form key id)
+//!   is the earlier form too: `earlier_form_object` under the shut doors.
+//! - **I3464** a trace that names an edition-2 kid AND carries a PQC member is
+//!   the earlier form: `earlier_form_object` shut; open, the cross-form
+//!   refusal `earlier_form_signer_is_edition2` (a composite's components are
+//!   never standalone signers).
+//! - **I3465** a trace signed by a key not of its kid (key B signs, the kid
+//!   names live key A) is refused `verify_signature_mismatch`.
+//! - **I3466** a composite trace altered after signing is refused
+//!   `verify_signature_mismatch`.
+//! - **I3467** a kid no valid key record is held for is refused
+//!   `verify_unknown_key`.
+//! - **I3468** a kid whose key is held but not live at the trace's signed
+//!   `completed_at` is refused `verify_signer_not_live`.
+//! - **I3469** the form is read from the envelope members alone, and the
+//!   signed message is `TRACE_SIGNATURE_CONTEXT || canonical_bytes_for_trace`.
+//! - **I3470** a composite signature over the canonical bytes WITHOUT the
+//!   domain tag is refused `verify_signature_mismatch` (the tag is load-bearing).
+//! - **I3471** a composite signature of the wrong length is refused
+//!   `verify_invalid_signature`.
+
+use super::*;
+use crate::federation::edition2::door::with_earlier_form_doors_shut;
+use crate::federation::edition2::fixture_switch as e2;
+use crate::federation::edition2::token;
+use crate::federation::FederationDirectory;
+use crate::schema::SchemaVersion;
+use crate::verify::ed25519::{
+    canonical_bytes_for_trace, trace_signature_form, trace_signature_message, TraceSignatureForm,
+    TRACE_SIGNATURE_CONTEXT,
+};
+use crate::verify::PythonJsonDumpsCanonicalizer;
+use base64::Engine as _;
+use chrono::{DateTime, Duration, SecondsFormat, Utc};
+
+fn unique(tag: &str) -> String {
+    format!(
+        "p7-{tag}-{}",
+        &uuid::Uuid::new_v4().simple().to_string()[..12]
+    )
+}
+
+fn wire(at: DateTime<Utc>) -> crate::schema::WireDateTime {
+    at.to_rfc3339_opts(SecondsFormat::Micros, true)
+        .parse()
+        .expect("rfc3339")
+}
+
+fn component(
+    component_type: crate::schema::ComponentType,
+    event_type: crate::schema::ReasoningEventType,
+    at: DateTime<Utc>,
+    data: serde_json::Value,
+) -> crate::schema::TraceComponent {
+    crate::schema::TraceComponent {
+        component_type,
+        event_type,
+        timestamp: wire(at),
+        data: data.as_object().cloned().unwrap_or_default(),
+        agent_id_hash: None,
+    }
+}
+
+/// An unsigned 2.7.0 trace sealed at `completed`, under `signature_key_id`.
+fn trace_at(completed: DateTime<Utc>, signature_key_id: &str) -> CompleteTrace {
+    let started = completed - Duration::seconds(20);
+    CompleteTrace {
+        trace_id: unique("trace"),
+        thought_id: "th-p7".into(),
+        task_id: Some("task-p7".into()),
+        agent_id_hash: "deadbeef".into(),
+        started_at: wire(started),
+        completed_at: wire(completed),
+        trace_level: crate::schema::TraceLevel::Generic,
+        trace_schema_version: SchemaVersion::parse("2.7.0").unwrap(),
+        components: vec![
+            component(
+                crate::schema::ComponentType::Observation,
+                crate::schema::ReasoningEventType::ThoughtStart,
+                started,
+                serde_json::json!({ "attempt_index": 0 }),
+            ),
+            component(
+                crate::schema::ComponentType::Action,
+                crate::schema::ReasoningEventType::ActionResult,
+                completed,
+                serde_json::json!({
+                    "attempt_index": 0,
+                    "audit_sequence_number": 42,
+                    "audit_entry_hash": "abcd",
+                    "audit_signature": "BBBB",
+                    "llm_calls": 0,
+                    "tokens_total": 100,
+                    "cost_cents": 0.1,
+                }),
+            ),
+        ],
+        deployment_profile: None,
+        cohort_scope: "federation".into(),
+        cohort_target_id: None,
+        signature: String::new(),
+        signature_key_id: signature_key_id.to_owned(),
+        signature_ml_dsa_65: None,
+        pubkey_ml_dsa_65: None,
+        pqc_key_id: None,
+        run_kind: None,
+    }
+}
+
+/// The Agent's v62 signing step: ONE composite signature by `seed`'s key over
+/// [`trace_signature_message`], standard base64, in `signature`.
+fn sign_composite(trace: &mut CompleteTrace, seed: &str) {
+    let canon = trace_canonicalizer(trace.trace_schema_version.as_str());
+    let message = trace_signature_message(trace, canon).expect("trace message");
+    let sig = e2::signing_key(seed)
+        .sign(&message)
+        .expect("composite sign");
+    trace.signature = BASE64.encode(sig);
+}
+
+/// Now, less an hour: inside a default `agent` key window (E0 v1.11: rows a
+/// node/agent key signs are now-relative).
+fn recently() -> DateTime<Utc> {
+    crate::host::clock::now() - Duration::hours(1)
+}
+
+async fn verdict<D>(d: &D, trace: &CompleteTrace) -> Result<(), IngestError>
+where
+    D: Backend + FederationDirectory + ?Sized,
+{
+    verify_trace_for_admission(d, trace, "p7-body", &PythonJsonDumpsCanonicalizer).await
+}
+
+fn kind_of(r: Result<(), IngestError>) -> &'static str {
+    match r {
+        Ok(()) => "admitted",
+        Err(e) => e.kind(),
+    }
+}
+
+/// I3460 + I3465 + I3466 + I3467 + I3468 + I3470 + I3471 on one backend.
+async fn exercise_composite_door<D>(d: &D)
+where
+    D: Backend + FederationDirectory + ?Sized,
+{
+    let a = unique("agent-a");
+    let b = unique("agent-b");
+    let kid_a = e2::put_key(d, &a, &["agent"]).await;
+    let _kid_b = e2::put_key(d, &b, &["agent"]).await;
+
+    // I3460 — admitted, doors open and shut.
+    let mut t = trace_at(recently(), &kid_a);
+    sign_composite(&mut t, &a);
+    assert_eq!(
+        trace_signature_form(&t),
+        TraceSignatureForm::Composite(e2::kid_digest(&a)),
+        "I3460: an identity-ref kid with no PQC member is the composite form"
+    );
+    assert_eq!(
+        kind_of(verdict(d, &t).await),
+        "admitted",
+        "I3460: doors open"
+    );
+    assert_eq!(
+        kind_of(with_earlier_form_doors_shut(verdict(d, &t)).await),
+        "admitted",
+        "I3460: the switch shuts the earlier form only"
+    );
+
+    // I3465 — B signs, the kid names A.
+    let mut wrong = trace_at(recently(), &kid_a);
+    sign_composite(&mut wrong, &b);
+    assert_eq!(
+        kind_of(verdict(d, &wrong).await),
+        "verify_signature_mismatch",
+        "I3465: a trace signed by a key not of its kid is refused"
+    );
+
+    // I3466 — altered after signing (a signed member).
+    let mut altered = t.clone();
+    altered.thought_id = "th-p7-altered".into();
+    assert_eq!(
+        kind_of(verdict(d, &altered).await),
+        "verify_signature_mismatch",
+        "I3466: a signed member changed after signing"
+    );
+
+    // I3467 — a kid with no record held.
+    let c = unique("agent-unheld");
+    let mut unheld = trace_at(recently(), &e2::kid(&c));
+    sign_composite(&mut unheld, &c);
+    assert_eq!(
+        kind_of(verdict(d, &unheld).await),
+        "verify_unknown_key",
+        "I3467: no valid record of the kid is held"
+    );
+
+    // I3468 — held, but no record covers the signed completed_at (a default
+    // agent window starts ~180 days back).
+    let mut stale = trace_at(crate::host::clock::now() - Duration::days(400), &kid_a);
+    sign_composite(&mut stale, &a);
+    assert_eq!(
+        kind_of(verdict(d, &stale).await),
+        "verify_signer_not_live",
+        "I3468: not covered at the trace's signed instant"
+    );
+
+    // I3470 — the same key over the bare canonical bytes (no domain tag).
+    let mut untagged = trace_at(recently(), &kid_a);
+    let canon = trace_canonicalizer(untagged.trace_schema_version.as_str());
+    let bare = canonical_bytes_for_trace(&untagged, canon).unwrap();
+    untagged.signature = BASE64.encode(e2::signing_key(&a).sign(&bare).unwrap());
+    assert_eq!(
+        kind_of(verdict(d, &untagged).await),
+        "verify_signature_mismatch",
+        "I3470: the domain tag is part of the signed message"
+    );
+
+    // I3471 — an Ed25519-length signature under a composite kid.
+    let mut short = trace_at(recently(), &kid_a);
+    short.signature = BASE64.encode([7u8; 64]);
+    assert_eq!(
+        kind_of(verdict(d, &short).await),
+        "verify_invalid_signature",
+        "I3471: not a composite's length"
+    );
+}
+
+/// I3462 + I3463 + I3464 on one backend.
+async fn exercise_earlier_form_refusals<D>(d: &D)
+where
+    D: Backend + FederationDirectory + ?Sized,
+{
+    // I3462 — the bound-hybrid shape (signature bytes are never read).
+    let mut hybrid = trace_at(recently(), "ciris-agent-key:p7-hybrid");
+    hybrid.signature = BASE64.encode([1u8; 64]);
+    hybrid.signature_ml_dsa_65 = Some(BASE64.encode([2u8; 3309]));
+    hybrid.pqc_key_id = Some("p7-mldsa".into());
+    assert_eq!(
+        trace_signature_form(&hybrid),
+        TraceSignatureForm::BoundHybrid
+    );
+    let shut = with_earlier_form_doors_shut(verdict(d, &hybrid)).await;
+    match &shut {
+        Err(IngestError::TraceRefused { kind, .. }) => {
+            assert_eq!(*kind, token::EARLIER_FORM_OBJECT, "I3462: refused by name");
+        }
+        other => panic!("I3462: expected TraceRefused(earlier_form_object), got {other:?}"),
+    }
+    let open = kind_of(verdict(d, &hybrid).await);
+    assert_ne!(
+        open,
+        token::EARLIER_FORM_OBJECT,
+        "I3462: with the doors open the switch does not refuse it"
+    );
+    assert_eq!(
+        open, "verify_unknown_key",
+        "I3462: open, it reaches the earlier-form lookup"
+    );
+
+    // I3463 — classical-only, an earlier-form key id.
+    let mut classical = trace_at(recently(), "ciris-agent-key:p7-classical");
+    classical.signature = BASE64.encode([1u8; 64]);
+    assert_eq!(
+        trace_signature_form(&classical),
+        TraceSignatureForm::BoundHybrid
+    );
+    assert_eq!(
+        kind_of(with_earlier_form_doors_shut(verdict(d, &classical)).await),
+        token::EARLIER_FORM_OBJECT,
+        "I3463: classical-only is the earlier form"
+    );
+
+    // I3464 — an edition-2 kid with a PQC member riding along.
+    let m = unique("agent-mixed");
+    let kid_m = e2::put_key(d, &m, &["agent"]).await;
+    let mut mixed = trace_at(recently(), &kid_m);
+    sign_composite(&mut mixed, &m);
+    mixed.signature_ml_dsa_65 = Some(BASE64.encode([2u8; 3309]));
+    assert_eq!(
+        trace_signature_form(&mixed),
+        TraceSignatureForm::BoundHybrid
+    );
+    assert_eq!(
+        kind_of(with_earlier_form_doors_shut(verdict(d, &mixed)).await),
+        token::EARLIER_FORM_OBJECT,
+        "I3464: shut, refused as the earlier form"
+    );
+    assert_eq!(
+        kind_of(verdict(d, &mixed).await),
+        crate::federation::malformed_row::EARLIER_FORM_SIGNER_IS_EDITION2,
+        "I3464: open, an edition-2 key is never a standalone component signer"
+    );
+}
+
+/// I3461 on one backend: the whole pipeline admits a composite trace.
+async fn exercise_pipeline_admits<D>(d: &D)
+where
+    D: Backend + FederationDirectory + ?Sized,
+{
+    let a = unique("agent-pipe");
+    let kid_a = e2::put_key(d, &a, &["agent"]).await;
+    let mut t = trace_at(recently(), &kid_a);
+    sign_composite(&mut t, &a);
+    let body = serde_json::json!({
+        "events": [{
+            "event_type": "complete_trace",
+            "trace_level": "generic",
+            "trace": serde_json::to_value(&t).unwrap(),
+        }],
+        "batch_timestamp": crate::host::clock::now().to_rfc3339(),
+        "consent_timestamp": "2025-01-01T00:00:00Z",
+        "trace_level": "generic",
+        "trace_schema_version": "2.7.0",
+    })
+    .to_string()
+    .into_bytes();
+
+    let signer_key_id = "p7-scrub-key-v1".to_owned();
+    let mut sw = ciris_keyring::Ed25519SoftwareSigner::new(&signer_key_id);
+    sw.import_key(&[0xA7u8; 32]).expect("import_key");
+    let signer: Box<dyn HardwareSigner> = Box::new(sw);
+    let pipeline = IngestPipeline {
+        backend: d,
+        canonicalizer: &PythonJsonDumpsCanonicalizer,
+        scrubber: &crate::scrub::NullScrubber,
+        signer: &*signer,
+        signer_key_id: &signer_key_id,
+    };
+    let summary = pipeline
+        .receive_and_persist(&body)
+        .await
+        .unwrap_or_else(|e| {
+            panic!(
+                "I3461: the composite trace is admitted, got {} ({e})",
+                e.kind()
+            )
+        });
+    assert_eq!(summary.signatures_verified, 1, "I3461: persist verified it");
+    assert!(summary.trace_events_inserted > 0, "I3461: its rows land");
+}
+
+/// I3469 — pure: the form and the message.
+#[test]
+fn i3469_form_and_message() {
+    let k = e2::kid("p7-pure");
+    let t = trace_at(Utc::now(), &k);
+    assert_eq!(
+        trace_signature_form(&t),
+        TraceSignatureForm::Composite(e2::kid_digest("p7-pure"))
+    );
+    for (label, mut u) in [
+        ("signature_ml_dsa_65", t.clone()),
+        ("pubkey_ml_dsa_65", t.clone()),
+        ("pqc_key_id", t.clone()),
+    ] {
+        match label {
+            "signature_ml_dsa_65" => u.signature_ml_dsa_65 = Some("x".into()),
+            "pubkey_ml_dsa_65" => u.pubkey_ml_dsa_65 = Some("x".into()),
+            _ => u.pqc_key_id = Some("x".into()),
+        }
+        assert_eq!(
+            trace_signature_form(&u),
+            TraceSignatureForm::BoundHybrid,
+            "I3469: {label} makes it the earlier form"
+        );
+    }
+    let mut earlier = t.clone();
+    earlier.signature_key_id = "ciris-agent-key:p7".into();
+    assert_eq!(
+        trace_signature_form(&earlier),
+        TraceSignatureForm::BoundHybrid
+    );
+
+    let canon = trace_canonicalizer(t.trace_schema_version.as_str());
+    let message = trace_signature_message(&t, canon).unwrap();
+    let canonical = canonical_bytes_for_trace(&t, canon).unwrap();
+    assert_eq!(
+        &message[..TRACE_SIGNATURE_CONTEXT.len()],
+        TRACE_SIGNATURE_CONTEXT
+    );
+    assert_eq!(
+        &message[TRACE_SIGNATURE_CONTEXT.len()..],
+        canonical.as_slice()
+    );
+}
