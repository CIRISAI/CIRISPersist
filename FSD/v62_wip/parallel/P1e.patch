+            .await
+            .unwrap();
+        b.run_migrations().await.unwrap();
+        Box::pin(body(Arc::new(b))).await;
+    }
+
+    #[cfg(feature = "postgres")]
+    #[tokio::test]
+    async fn i2919_the_lists_are_enforced_at_the_door_postgres() {
+        use crate::store::Backend as _;
