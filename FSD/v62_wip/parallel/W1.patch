+fn is_payload_invalid(e: &Error) -> bool {
+    matches!(
+        e,
+        Error::MalformedRow { reason, .. }
+            if *reason == crate::federation::malformed_row::EDITION2_PAYLOAD_INVALID
+    )
+}
