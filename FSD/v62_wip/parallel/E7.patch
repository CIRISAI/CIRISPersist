-                    named
-                        .entry(k.clone())
-                        .or_default()
-                        .push(c.as_str().unwrap().to_owned());
-                }
-            }
-            prev_hash = compute_persist_row_hash(&f).unwrap();
-            prev_charter = f.charter_digest.clone();
-        }
