-
-        assert_eq!(
-            art["original_content_hash_hex"]
-                .as_str()
-                .expect("original_content_hash_hex is a string"),
-            hex::encode(Sha256::digest(&gate)),
-            "original_content_hash_hex must be sha256 of the produce-gate bytes"
