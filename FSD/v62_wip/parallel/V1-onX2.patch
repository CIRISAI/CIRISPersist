+/// v62.0.0 (wave V1b; CC 2.4.1.1) — is `row` a COUNTED act of a named
+/// group ([`counted_group_of`])?
+#[must_use]
+pub fn is_counted_group_row(row: &super::Attestation) -> bool {
+    counted_group_of(row).is_some()
+}
