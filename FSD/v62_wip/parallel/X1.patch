+        Value::Array(a) => {
+            let mut out: Vec<Value> = a.iter().map(|x| recite(x, old, new)).collect();
+            if !out.is_empty() && out.iter().all(|x| x.as_array().is_some()) {
+                out.sort_by_key(cde::encode);
+            }
+            Value::Array(out)
         }
+        Value::Tag(t, x) => Value::Tag(*t, Box::new(recite(x, old, new))),
+        other => other.clone(),
+    }
+}
