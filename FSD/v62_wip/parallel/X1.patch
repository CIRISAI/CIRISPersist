-#[cfg(feature = "postgres")]
-async fn drop_pg(base: &str, name: &str) {
-    if let Ok((admin, conn)) = tokio_postgres::connect(base, tokio_postgres::NoTls).await {
-        tokio::spawn(conn);
-        let _ = admin
-            .batch_execute(&format!("DROP DATABASE IF EXISTS \"{name}\" WITH (FORCE)"))
-            .await;
-    }
-}
