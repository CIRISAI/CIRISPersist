+fn digest_mismatch(row: &Attestation, reason: &'static str, detail: String) -> Error {
+    Error::InvalidArgument(format!(
+        "{AMENDMENT_DIGEST_MISMATCH}: {reason}: amendment {} — {detail} (CC 3.1.5 rc21, \
+         CIRISServer#1366)",
+        row.attestation_id
