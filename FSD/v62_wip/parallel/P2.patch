+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::federation::tier_ingest::test_support as ts;
+
+    fn approval(digest: Option<serde_json::Value>) -> Attestation {
+        let id = uuid::Uuid::new_v4().to_string();
+        let mut env = serde_json::json!({ "id": id, "dimension": DEFERRAL_APPROVED_DIMENSION });
+        if let Some(d) = digest {
+            env[AMENDMENT_DIGEST_MEMBER] = d;
+        }
+        let mut r = ts::bare_attestation(&id, "i2930-wa", "i2930-agent", &env);
+        r.attestation_type = attestation_type::SCORES.to_owned();
+        r
+    }
+
+    fn amendment() -> Attestation {
+        let id = uuid::Uuid::new_v4().to_string();
+        let mut r = ts::bare_attestation(
+            &id,
+            "i2930-agent",
+            "i2930-agent",
+            &serde_json::json!({ "id": id, "dimension": IDENTITY_AMENDMENT_DIMENSION }),
+        );
+        r.attestation_type = attestation_type::SCORES.to_owned();
+        r
+    }
+
+    fn refused_with(r: Result<(), Error>, reason: &str, what: &str) {
+        match r {
+            Err(Error::InvalidArgument(m)) => assert!(
+                m.starts_with(&format!("{AMENDMENT_DIGEST_MISMATCH}: {reason}: ")),
+                "I2930 ({what}): expected {reason}, got {m}"
+            ),
+            other => panic!("I2930 ({what}): expected {AMENDMENT_DIGEST_MISMATCH}, got {other:?}"),
+        }
+    }
+
+    /// **I2930 (CC 3.1.5 rc21; CIRISServer#1365/#1366)** — the approved-text
+    /// check, as a pure function of the two rows: an equal digest passes; an
+    /// absent, ill-shaped (uppercase, short, non-string, null) or different
+    /// one is refused `amendment_digest_mismatch`, each case named in the
+    /// message. Mutation targets: the equality and the absent arm.
+    #[test]
+    fn i2930_the_amendment_is_the_text_the_wa_approved() {
+        let digest = "cd".repeat(32);
+        let row = amendment();
+        check_approved_digest(&row, &digest, &approval(Some(serde_json::json!(digest))))
+            .expect("I2930: the approved text admits");
+
+        use digest_mismatch_reason as why;
+        refused_with(
+            check_approved_digest(&row, &digest, &approval(None)),
+            why::RESPONSE_NAMES_NO_TEXT,
+            "absent",
+        );
+        refused_with(
+            check_approved_digest(
+                &row,
+                &digest,
+                &approval(Some(serde_json::json!("ef".repeat(32)))),
+            ),
+            why::DIGESTS_DIFFER,
+            "another text",
+        );
+        for (bad, what) in [
+            (serde_json::json!("CD".repeat(32)), "uppercase"),
+            (serde_json::json!("cd".repeat(31)), "short"),
+            (serde_json::json!(7), "a number"),
+            (serde_json::Value::Null, "null"),
+        ] {
+            refused_with(
+                check_approved_digest(&row, &digest, &approval(Some(bad))),
+                why::RESPONSE_DIGEST_ILL_SHAPED,
+                what,
+            );
+        }
+        // The token is its own, not the authority token: a consumer keys on it.
+        assert_ne!(AMENDMENT_DIGEST_MISMATCH, IDENTITY_AMENDMENT_UNAUTHORIZED);
+    }
+}
