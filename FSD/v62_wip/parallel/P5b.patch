+        let at = now_s() - chrono::Duration::minutes(3);
+        touch(d, target, at).await.unwrap();
+        assert_eq!(
+            floor(d, target).await.map(|f| f.fresh_as_of),
+            Some(at),
+            "I3117: the floor"
+        );
+        assert_eq!(
