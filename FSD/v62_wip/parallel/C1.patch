+            .and_then(|d| d.split(',').next())
+            .unwrap_or_default();
+        return Error::unknown_signer(&format!("{GENESIS_BUNDLE_TYP}:{first}"), PLANE);
+    }
+    refuse(
+        n.token,
+        format!(
+            "{}: bundle {oid} is not placed (CC 2.6.1.11); nothing of it is stored",
+            n.detail.as_deref().unwrap_or(n.token)
+        ),
+    )
