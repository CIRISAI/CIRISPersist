+#[cfg(test)]
+mod unit {
+    use crate::federation::edition2::emit::payload_from_envelope;
+    use crate::federation::hard_case::{self, edition2_reals, HardCaseEvent};
+
+    /// **I3057** — a hard_case body carries no floats on the clean mesh: a
+    /// real under `score` / `confidence` / `weight` (or an array under one)
+    /// is fixed6, any other real a decimal string; integers are unchanged.
+    /// An event whose `detail` holds reals then states as a payload (the
+    /// payload builder refuses any float).
+    #[test]
+    fn i3057_a_real_in_detail_is_fixed6_or_a_decimal_string() {
+        assert_eq!(
+            edition2_reals(
+                serde_json::json!({
+                    "score": 0.75,
+                    "ratio": 0.25,
+                    "count": 3,
+                    "nested": {"confidence": [0.5, 1], "label": "x"},
+                }),
+                None,
+            ),
+            serde_json::json!({
+                "score": 750_000,
+                "ratio": "0.25",
+                "count": 3,
+                "nested": {"confidence": [500_000, 1], "label": "x"},
+            }),
+            "I3057"
+        );
+        let event = HardCaseEvent {
+            event_id: "i3057-ev".to_owned(),
+            kind: hard_case::kind::LINEAGE_EQUIVOCATION.to_owned(),
+            target_key_id: None,
+            subject_key_id: None,
+            detail: serde_json::json!({"score": 0.5, "drift": 1.5}),
+            emitted_at: chrono::DateTime::<chrono::Utc>::from_timestamp_millis(1_790_000_000_000)
+                .expect("ms"),
+            emitter_key_id: String::new(),
+        };
+        let input = hard_case::hard_case_emit_input(&event, event.emitted_at)
+            .expect("I3057: the input builds");
+        let envelope = input.attestation_envelope.to_value();
+        assert_eq!(
+            envelope[hard_case::BODY_MEMBER]["detail"],
+            serde_json::json!({"score": 500_000, "drift": "1.5"}),
+            "I3057: the stated detail"
+        );
+        assert!(
+            payload_from_envelope(&envelope, 0, None, &[]).is_ok(),
+            "I3057: a detail with reals states as a payload"
+        );
+        // Without the restatement the payload builder refuses the float.
+        let mut raw = envelope.clone();
+        raw[hard_case::BODY_MEMBER]["detail"]["drift"] = serde_json::json!(1.5);
+        assert!(
+            payload_from_envelope(&raw, 0, None, &[]).is_err(),
+            "I3057: a float in a payload is refused"
+        );
+    }
+}
