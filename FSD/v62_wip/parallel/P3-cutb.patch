+/// v62.0.0 (v62 P3) — **the reals of a hard_case body, stated without
+/// floats** (CC 2.6.1.5: an edition-2 payload carries integers; a score,
+/// confidence or weight is an integer at the fixed scale of 10^6). `detail` is
+/// open vocabulary, so a real can appear anywhere in it:
+///
+/// - under a member named in
+///   [`SCALED_MEMBERS`](super::edition2::ingest::SCALED_MEMBERS) (`score`,
+///   `confidence`, `weight`; an array under one inherits its name): the
+///   integer `round(x × 10^6)`, the fixed6 form every payload's scaled
+///   members take;
+/// - anywhere else: its shortest decimal string (`0.25` → `"0.25"`), never
+///   rounded, so nothing the emitter observed is lost.
+///
+/// Integers, text, booleans and nulls are unchanged. Applied on the
+/// edition-2 producer only; the node-local row keeps the event as built.
+#[must_use]
+pub fn edition2_reals(value: serde_json::Value, member: Option<&str>) -> serde_json::Value {
+    use serde_json::Value as J;
+    match value {
+        J::Number(n) if n.as_u64().is_none() && n.as_i64().is_none() => {
+            let scaled =
+                member.is_some_and(|m| super::edition2::ingest::SCALED_MEMBERS.contains(&m));
+            match n.as_f64() {
+                Some(x) if scaled => {
+                    #[allow(clippy::cast_possible_truncation)]
+                    let fixed = (x * 1_000_000.0).round() as i64;
+                    J::from(fixed)
+                }
+                _ => J::String(n.to_string()),
+            }
+        }
+        J::Array(items) => J::Array(
+            items
+                .into_iter()
+                .map(|item| edition2_reals(item, member))
+                .collect(),
+        ),
+        J::Object(members) => J::Object(
+            members
+                .into_iter()
+                .map(|(k, v)| {
+                    let v = edition2_reals(v, Some(&k));
+                    (k, v)
+                })
+                .collect(),
+        ),
+        other => other,
+    }
+}
