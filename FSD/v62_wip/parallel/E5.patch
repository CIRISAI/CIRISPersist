-        // One vote — below quorum, but stored and servable.
-        let digest = seed_quorum(
-            dir,
-            &node,
-            OP_WITHDRAW_INFRA_ATTEST,
-            &target,
-            &[0],
-            &format!("ad-{tag}"),
