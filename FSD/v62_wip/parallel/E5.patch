-                run_concurrent_carrier_bound_matrix(std::sync::Arc::new(a), "cbp").await;
-            })
-            .await;
-            crate::federation::admission::run_in_isolated_pg_db(&dsn, |a| async move {
-                run_concurrent_overlap_matrix(std::sync::Arc::new(a), "ccp").await;
-            })
