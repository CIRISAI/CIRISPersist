-/// 1216 deterministic pseudo-random bytes (synthetic; xorshift64*).
-fn xwing_bytes() -> Vec<u8> {
-    let mut s: u64 = 0x9E37_79B9_7F4A_7C15;
-    (0..XWING_LEN)
-        .map(|_| {
-            s ^= s >> 12;
-            s ^= s << 25;
-            s ^= s >> 27;
-            (s.wrapping_mul(0x2545_F491_4F6C_DD1D) >> 56) as u8
-        })
-        .collect()
-}
