-    );
-
-    install_test_ceremony_outputs(c.bundle.clone());
-    seed_family_and_canonical(d)
-        .await
-        .unwrap_or_else(|e| panic!("{tag} I428: the upgraded boot: {e:?}"));
-
-    let carried = c
-        .bundle
-        .family_record(accord)
