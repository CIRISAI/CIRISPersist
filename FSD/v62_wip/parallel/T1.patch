+fn o_row(o: &StatementOutcome) -> RowId {
+    match o {
+        StatementOutcome::Row { row_id, .. } | StatementOutcome::Pending { row_id, .. } => *row_id,
+        other => panic!("not a group row: {other:?}"),
+    }
+}
