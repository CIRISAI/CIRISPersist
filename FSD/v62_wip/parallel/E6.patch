-        next.prev_head_digest = held.persist_row_hash.clone();
-        next.charter_digest = fresh_digest.clone();
-        next.persist_row_hash = String::new();
-        let reserved = |e: &Error| matches!(e, Error::ConstitutionalFamilyReserved { .. });
