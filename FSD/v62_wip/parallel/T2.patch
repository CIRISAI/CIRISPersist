+    let si = iref(&s);
+    let p = delivery_receipt_payload(&si, "t2-stream", 2, 17, &[0x3a; 32], 1_000);
+    let a = attestation_of(&admitted(&s, &si, DELIVERY_RECEIPT_PREFIX, &p), INGEST_TIER).unwrap();
+    assert_eq!(
