+fn sign_typed(k: &K, row_type: &str, sub: &str, prefix: &str, p: &Value) -> Vec<u8> {
+    sign_row_statement(k, &iref(k), sub, row_type, &family_id(prefix), p, vec![]).unwrap()
+}
