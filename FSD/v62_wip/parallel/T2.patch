+fn accepts(granter: &K, key: &str, scope: &str, until: Option<u64>, t: u64) -> Vec<u8> {
+    let p = trust_accepts_payload(
+        &iref(granter),
+        &[crate::federation::trust_root::INFRA_SERVE_SCOPE],
+        &[],
+        until,
+        scope,
+        t,
+    );
+    sign_typed(granter, "delegates_to", key, TRUST_PREFIX, &p)
+}
